@model IEnumerable<AgroClassLib.FarmOwner.ServiceManagement>
@{
    ViewBag.Title = "Food Services (Meals)";
    Layout = "~/Views/Shared/FarmOwner.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Food Services (Meals)</h3>
    </div>

    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Food Code</th>
                <th>Meal Type</th>
                <th>Food Style</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.FoodServiceCode</td>
                    <td>@item.MealName</td>
                    <td>@item.FoodStyleName</td>
                    <td>@item.StartTime</td>
                    <td>@item.EndTime</td>

                    <td>

                        <!-- VIEW -->
                        <button class="btn btn-warning btn-sm"
                                onclick="viewFood('@item.FoodServiceCode')">
                            View
                        </button>

                        <!-- EDIT -->
                        <button class="btn btn-info btn-sm"
                                onclick="editFood('@item.FoodServiceCode')">
                            Edit
                        </button>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


<!-- VIEW MODAL -->

<div class="modal fade" id="viewModal">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Food Service Details</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="viewModalBody"></div>

        </div>
    </div>
</div>


<!-- EDIT MODAL -->

<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Food Service</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="editModalBody"></div>

        </div>
    </div>
</div>
@section Scripts{

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

function viewFood(id)
{
    $.ajax({

        url: '@Url.Action("FoodServiceView", "FarmOwner")',

        type: 'GET',

        data: { id: id },

        success: function (data)
        {
            $("#viewModalBody").html(data);

            var modal = new bootstrap.Modal(document.getElementById('viewModal'));
            modal.show();
        }

    });
}


function editFood(id)
{
    $.ajax({

        url: '@Url.Action("FoodServiceModal", "FarmOwner")',

        type: 'GET',

        data: { id: id },

        success: function (data)
        {
            $("#editModalBody").html(data);

            var modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }
    });
}

    </script>

}