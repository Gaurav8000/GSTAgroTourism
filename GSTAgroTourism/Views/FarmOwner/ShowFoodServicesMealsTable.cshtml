@model IEnumerable<AgroClassLib.FarmOwner.ServiceManagement>
@{
    ViewBag.Title = "Food Services (Meals)";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Food Services (Meals)</h3>

        <button id="btnAddMeal" class="btn btn-primary">
            <i class="fa fa-plus"></i> Add Meal
        </button>
    </div>

    <div class="card">

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped">

                <thead class="thead-dark">
                    <tr>
                        <th>Food Service Code</th>
                        <th>Meal Type</th>
                        <th>Food Style</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th style="width:120px;">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FoodServiceCode</td>
                            <td>@item.MealName</td>
                            <td>@item.FoodStyleName</td>
                            <td>@item.StartTime</td>
                            <td>@item.EndTime</td>

                            <td>
                                <button class="btn btn-warning btn-sm btnEdit"
                                        data-id="@item.FoodServiceCode">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="foodModal" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <div class="modal-body" id="foodModalBody">
                </div>

            </div>
        </div>
    </div>
</div>
@section Scripts{

    <script>

        $(document).ready(function () {

            // Add Meal
            $("#btnAddMeal").click(function () {

                $.get('/FarmOwner/FoodServiceModal', function (data) {

                    $("#foodModalBody").html(data);

                    $("#foodModal").modal('show');

                });

            });


            // Edit Meal
            $(".btnEdit").click(function () {

                var id = $(this).data("id");

                $.get('/FarmOwner/FoodServiceModal', { id: id }, function (data) {

                    $("#foodModalBody").html(data);

                    $("#foodModal").modal('show');

                });

            });

        });

    </script>

}