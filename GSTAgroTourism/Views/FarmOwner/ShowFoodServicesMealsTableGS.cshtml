@model IEnumerable<AgroClassLib.FarmOwner.ServiceManagement>
@{
    ViewBag.Title = "Food Services (Meals)";
    Layout = "~/Views/Shared/FarmOwner.cshtml";
}
<style>
    /* ===== DataTable UI Styling ===== */

    #dataTable {
        border-radius: 10px;
        overflow: hidden;
    }

        #dataTable thead th {
            background: linear-gradient(90deg,#1f3b63,#2f5d9a);
            color: white;
            font-size: 15px;
            text-align: center;
        }

        #dataTable tbody tr:hover {
            background: #f4f7fb;
            transition: 0.2s;
        }

        #dataTable tbody td {
            font-size: 14px;
            padding: 10px !important;
        }

    /* Table Borders */
    .dataTable th,
    .dataTable td {
        border: 1px solid #ddd !important;
        text-align: center;
        vertical-align: middle;
    }

    /* Buttons styling */
    .dt-button {
        background: #1f3b63 !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important;
        padding: 8px 15px !important;
        margin-right: 5px !important;
        font-size: 14px !important;
    }

        .dt-button:hover {
            background: #0f2f57 !important;
        }

    /* Search & dropdown */
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px 10px;
    }

    tr.group {
        background: #e9f1ff;
        font-weight: bold;
        cursor: pointer;
    }
</style>
<!-- FILTER SECTION -->
<div class="card mb-3">
    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label>Search</label>
                <input type="text" id="tableSearch" class="form-control" placeholder="Search...">
            </div>

            <div class="col-md-3">
                <label>Meal Type</label>

                @Html.DropDownList(
      "MealTypeCode",
      ViewBag.MealTypeList as SelectList,
      "All",
      new { @class = "form-select", id = "MealTypeFilter" }
  )

            </div>
            <div class="col-md-3">
                <label>Food Style</label>
                @Html.DropDownList(
"MealTypeCode",
ViewBag.FoodTypeList as SelectList,
"All",
new { @class = "form-select", id = "FoodTypeList" }
)
            </div>
            <div class="col-md-3">
                <label>&nbsp;</label>
                <button id="refreshBtn" class="btn btn-outline-primary w-100">
                    <i class="fa fa-rotate-right"></i> Reset
                </button>
            </div>

        </div>
    </div>
</div>
<ul class="nav nav-tabs  justify-content-center">
    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Room" ? "active" : "")"
           href="@Url.Action("ShowRoomTableGS","FarmOwner")">
            Rooms
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Food" ? "active" : "")"
           href="@Url.Action("ShowFoodServicesMealsTableGS","FarmOwner")">
            Food Services
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Activity" ? "active" : "")"
           href="@Url.Action("ShowActivityTable","FarmOwner")">
            Activities
        </a>
    </li>
</ul>

<!-- Export Buttons -->
<div>
    <button id="excelBtn" class="btn btn-outline-success btn-rounded">
        <i class="fa fa-file-excel"></i>
    </button>

    <button id="pdfBtn" class="btn btn-outline-danger btn-rounded">
        <i class="fa fa-file-pdf"></i>
    </button>

    <button id="printBtn" class="btn btn-outline-primary btn-rounded">
        <i class="fa fa-print"></i>
    </button>
</div>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Food Services (Meals)</h3>
        <div class="d-flex justify-content-between mb-3">

            <button class="btn btn-success"
                    onclick="addFood()">
                <i class="fa fa-plus"></i> Add Meal
            </button>
        </div>
    </div>

    <table id="dataTable" class="table table-bordered table-hover text-center align-middle">

        <thead class="text-center">
            <tr>
                <th class="text-center" style="width:0px">
                    <input type="checkbox" id="selectAll" />
                </th>
                <th>Sr.No</th>
                <th>Meal Type</th>
                <th>Food Style</th>
                <th>Farmhouse Name</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody class="text-center">
            @{
                int sr = 1;
            }


            @foreach (var item in Model)
            {
                <tr>

                    @Html.HiddenFor(modelItem => item.FoodServiceCode)
                    <td>
                        <input type="checkbox" class="rowCheckbox" />
                    </td>
                    <td>@sr</td>
                    <td>@item.MealName</td>
                    <td>@item.FoodStyleName</td>
                    <td>@item.FarmhouseName</td>
                    <td>@item.StartTime</td>
                    <td>@item.EndTime</td>

                    <td>

                        <!-- VIEW -->

                        <button type="button" class="btn btn-outline-warning btn-rounded" onclick="viewFood('@item.FoodServiceCode')">
                            <i class="fa fa-eye"></i> View
                        </button>

                        <!-- EDIT -->
                        <button type="button" class="btn btn-outline-primary btn-rounded" onclick="editFood('@item.FoodServiceCode')">
                            <i class="fa fa-pencil"></i> Edit
                        </button>

                    </td>

                </tr>
                sr++;
            }

        </tbody>

    </table>

</div>


<!-- VIEW MODAL -->

<div class="modal fade" id="viewModal">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Food Service Details</h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="viewModalBody"></div>

        </div>
    </div>
</div>


<!-- EDIT MODAL -->

<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-lg">

        <div class="modal-content ">

            <div class="modal-header">
                <h5 class="modal-title" id="foodModalTitle">Food Service</h5>
                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="editModalBody"></div>

        </div>
    </div>
</div>
@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var exportSrNo = 0;
        /* SEARCH FILTER */
        $('#tableSearch').keyup(function () {

            table.search($(this).val()).draw();

        });

        /* MEAL TYPE FILTER */
        $('#MealTypeFilter').change(function () {

            var selected = $(this).find("option:selected").text();

            if (selected === "All") {
                table.column(2).search('').draw();
            }
            else {
                table.column(2).search('^' + selected + '$', true, false).draw();
            }

        });

        /* FOOD STYLE FILTER */
        $('#FoodTypeList').change(function () {

            var selected = $(this).find("option:selected").text();

            if (selected === "All") {
                table.column(3).search('').draw();
            }
            else {
                table.column(3).search('^' + selected + '$', true, false).draw();
            }

        });


        /* RESET FILTER */
        $('#refreshBtn').click(function () {

            // Reset search box
            $('#tableSearch').val('');

            // Reset dropdowns
            $('#MealTypeFilter').val('');
            $('#FoodTypeList').val('');

            // Reset DataTable filters
            table.search('').columns().search('').draw();

            // Uncheck all row checkboxes
            $('.rowCheckbox').prop('checked', false);

            // Uncheck Select All
            $('#selectAll').prop('checked', false);

        });



$(document).ready(function () {

    var table;
    var exportSrNo = 0;
    function getDateTime() {
        var now = new Date();
        var date = now.toLocaleDateString();
        var time = now.toLocaleTimeString();
        return "Generated on: " + date + " " + time;
    }

    $(document).ready(function () {

        table = $('#dataTable').DataTable({
            responsive: true,
            pageLength: 25,
            dom: 'lfrtip',
            ordering: false,

            columnDefs: [
                { visible: false, targets: 4 }
            ],

            order: [[5, 'asc']],

            drawCallback: function (settings) {

                var api = this.api();
                var rows = api.rows({ page: 'current' }).nodes();
                var last = null;

                api.column(4, { page: 'current' }).data().each(function (group, i) {

                    if (last !== group) {

                        $(rows).eq(i).before(
                            '<tr class="group"><td colspan="8">▶ ' + group + '</td></tr>'
                        );

                        last = group;
                    }

                });

            },


            buttons: [

                // ===== EXCEL =====
                {
                    extend: 'excelHtml5',
                    className: 'buttons-excel',

                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6],

                        rows: function (idx, data, node) {
                            return $(node).find('.rowCheckbox').prop('checked');
                        },

                        format: {
                            body: function (data, row, column, node) {

                                if (column === 0) {
                                    exportSrNo++;
                                    return exportSrNo;
                                }

                                return $('<div>').html(data).text();
                            }
                        }
                    },

                    // 🔥 ADD DATE IN EXCEL
                    customize: function (xlsx) {

                        var sheet = xlsx.xl.worksheets['sheet1.xml'];

                        var now = new Date();
                        var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                        $('sheetData', sheet).prepend(
                            '<row r="1">' +
                            '<c t="inlineStr" r="A1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="B1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="C1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="D1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="E1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="F1"><is><t></t></is></c>' +
                            '<c t="inlineStr" r="G1"><is><t>Generated on: ' + dateTime + '</t></is></c>' +
                            '</row>'
                        );
                    },

                    action: function (e, dt, button, config) {

                        var selected = $('.rowCheckbox:checked').length;

                        if (selected === 0) {
                            showToast("Please select at least one row!", "info");
                            return;
                        }

                        exportSrNo = 0;

                        $.fn.dataTable.ext.buttons.excelHtml5.action
                            .call(this, e, dt, button, config);

                        setTimeout(function () {
                            Swal.fire({
                                icon: 'success',
                                title: 'Excel Generated!',
                                text: 'Your Excel file has been downloaded successfully.',
                                confirmButtonColor: '#1f3b63'
                            });
                        }, 800);
                    }
                },

                // ===== PDF =====
                {
                    extend: 'pdfHtml5',
                    className: 'buttons-pdf',

                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6],

                        rows: function (idx, data, node) {
                            return $(node).find('.rowCheckbox').prop('checked');
                        },

                        format: {
                            body: function (data, row, column, node) {

                                if (column === 0) {
                                    exportSrNo++;
                                    return exportSrNo;
                                }

                                return $('<div>').html(data).text();
                            }
                        }
                    },

                    // 🔥 FIXED DATE HEADER
                    customize: function (doc) {

                        var now = new Date();
                        var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                        doc.header = function () {
                            return {
                                columns: [
                                    { text: '', width: '*' },
                                    {
                                        text: "Generated on: " + dateTime,
                                        alignment: 'right',
                                        margin: [0, 10, 20, 0],
                                        fontSize: 10,
                                        bold: true
                                    }
                                ]
                            };
                        };

                        var colCount = doc.content[1].table.body[0].length;
                        doc.content[1].table.widths = Array(colCount).fill('*');
                    },

                    action: function (e, dt, button, config) {

                        var selected = $('.rowCheckbox:checked').length;

                        if (selected === 0) {
                            showToast("Please select at least one row!", "info");
                            return;
                        }

                        exportSrNo = 0;

                        $.fn.dataTable.ext.buttons.pdfHtml5.action
                            .call(this, e, dt, button, config);

                        setTimeout(function () {
                            Swal.fire({
                                icon: 'success',
                                title: 'PDF Generated!',
                                text: 'Your PDF file has been downloaded successfully.',
                                confirmButtonColor: '#1f3b63'
                            });
                        }, 800);
                    }
                },

                // ===== PRINT =====
                {
                    extend: 'print',
                    className: 'buttons-print',

                    exportOptions: {
                        columns: [1, 2, 3, 4, 5, 6],

                        rows: function (idx, data, node) {
                            return $(node).find('.rowCheckbox').prop('checked');
                        },

                        format: {
                            body: function (data, row, column, node) {

                                if (column === 0) {
                                    exportSrNo++;
                                    return exportSrNo;
                                }

                                return $('<div>').html(data).text();
                            }
                        }
                    },

                    // 🔥 ADD DATE IN PRINT
                    customize: function (win) {

                        var now = new Date();
                        var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                        $(win.document.body).prepend(
                            '<div style="text-align:right; font-size:12px; margin-bottom:10px;">' +
                            'Generated on: ' + dateTime +
                            '</div>'
                        );
                    },

                    action: function (e, dt, button, config) {

                        var selected = $('.rowCheckbox:checked').length;

                        if (selected === 0) {
                            showToast("Please select at least one row!", "info");
                            return;
                        }

                        exportSrNo = 0;

                        $.fn.dataTable.ext.buttons.print.action
                            .call(this, e, dt, button, config);
                    }
                }

            ]

        });

        /* EXPORT BUTTONS */

        $('#excelBtn').click(function () {
            table.button('.buttons-excel').trigger();
        });

        $('#pdfBtn').click(function () {
            table.button('.buttons-pdf').trigger();
        });

        $('#printBtn').click(function () {
            table.button('.buttons-print').trigger();
        });

    });

    // Select All
    $('#selectAll').on('click', function () {
        $('.rowCheckbox').prop('checked', this.checked);
    });

    // Row Checkbox
    $(document).on("change", ".rowCheckbox", function () {

        let total = $(".rowCheckbox").length;
        let checked = $(".rowCheckbox:checked").length;

        $("#selectAll").prop("checked", total === checked);

    });

});

// View Modal
function viewFood(id) {

    $.get('@Url.Action("FoodServiceViewGS","FarmOwner")', { id: id }, function (data) {

        $("#viewModalBody").html(data);

        var modal = new bootstrap.Modal(document.getElementById('viewModal'));
        modal.show();

    });

}

// Edit Modal
function editFood(id) {

    $.get('@Url.Action("FoodServiceModalGS","FarmOwner")', { id: id }, function (data) {

        $("#foodModalTitle").text("Edit Food Service");
        $("#editModalBody").html(data);

        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();

    });

}

// Add Modal
function addFood() {

    $.get('@Url.Action("FoodServiceModalGS","FarmOwner")', function (data) {

        $("#foodModalTitle").text("Add Food Service");
        $("#editModalBody").html(data);

        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();

    });

        }
        $('#dataTable tbody').on('click', 'tr.group', function () {

            var nextRows = $(this).nextUntil('.group');

            if (nextRows.is(':visible')) {
                nextRows.hide();
            } else {
                nextRows.show();
            }

        });
        function showToast(message, type = "info") {

            let icon = "fa-circle-info";
            let bg = "#17a2b8";

            if (type === "success") { icon = "fa-circle-check"; bg = "#28a745"; }
            if (type === "error") { icon = "fa-circle-xmark"; bg = "#dc3545"; }

            let toast = `
        <div style="min-width:250px;padding:12px;
        background:${bg};color:#fff;border-radius:6px;
        position:fixed;top:20px;right:20px;z-index:9999;">
        <i class="fa ${icon}"></i> ${message}
        </div>`;

            let el = $(toast).appendTo('body');

            setTimeout(() => {
                el.fadeOut(500, function () { $(this).remove(); });
            }, 3000);
        }
    </script>

}