@model AgroClassLib.FarmOwner.ServiceManagement

@using (Html.BeginForm("SaveActivity", "FarmOwner",
FormMethod.Post,
new { enctype = "multipart/form-data", id = "activityForm" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.ActivityCode)

    <div class="form-horizontal">

        <h4 class="mb-3">

            @(string.IsNullOrEmpty(Model?.ActivityCode)
? "Add Activity"
: "Edit Activity")

        </h4>

        <hr />

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Activity Name
            </label>

            <div class="col-md-9">

                @Html.TextBoxFor(m => m.ActivityName,
                new { @class = "form-control" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Duration
            </label>

            <div class="col-md-9">

                @Html.TextBoxFor(m => m.Duration,
                new { @class = "form-control" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Price
            </label>

            <div class="col-md-9">

                @Html.TextBoxFor(m => m.Price,
                new { @class = "form-control" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Start Date
            </label>

            <div class="col-md-9">

                @Html.TextBoxFor(m => m.StartDate,
                new { @class = "form-control", type = "date" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                End Date
            </label>

            <div class="col-md-9">

                @Html.TextBoxFor(m => m.EndDate,
                new { @class = "form-control", type = "date" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Description
            </label>

            <div class="col-md-9">

                @Html.TextAreaFor(m => m.Description,
                new { @class = "form-control", rows = "3" })

            </div>

        </div>

        <div class="form-group row">

            <label class="col-md-3 col-form-label">
                Upload Image
            </label>

            <div class="col-md-9">

                <input type="file" name="ImageUpload" class="form-control" />

            </div>

        </div>

        <div class="form-group row">

            <div class="col-md-9 offset-md-3">

                <button type="submit" class="btn btn-success">

                    @(string.IsNullOrEmpty(Model?.ActivityCode)
? "Save"
: "Update")

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">

                    Cancel

                </button>

            </div>

        </div>

    </div>

}
<script>

    $(document).ready(function () {

        $("#activityForm").submit(function (e) {

            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({

                url: '/FarmOwner/SaveActivity',

                type: 'POST',

                data: formData,

                processData: false,

                contentType: false,

                success: function (result) {

                    if (result.success) {

                        $("#activityModal").modal('hide');

                        location.reload();

                    }
                    else {

                        $("#activityModalBody").html(result);

                    }

                }

            });

        });

    });

</script>
}