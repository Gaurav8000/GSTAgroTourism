@model AgroClassLib.FarmOwner.ServiceManagement

<div class="container">

    <h4>View Room</h4>

    <hr />

    <div class="form-group">
        <label>Room Name</label>
        @Html.TextBoxFor(m => m.RoomName,
        new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        <label>Room Type</label>
        @Html.TextBoxFor(m => m.RoomType,
        new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        <label>Guests</label>
        @Html.TextBoxFor(m => m.NumberOfGuests,
        new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        <label>Price</label>
        @Html.TextBoxFor(m => m.PricePerNight,
        new { @class = "form-control", @readonly = "readonly" })
    </div>

    @if (!string.IsNullOrEmpty(Model?.ImageFile))
    {
        <img src="@Url.Content(Model.ImageFile)"
             width="120"
             class="img-thumbnail" />
    }

    <br /><br />

    <button class="btn btn-secondary"
            data-dismiss="modal">
        Close
    </button>

</div>
