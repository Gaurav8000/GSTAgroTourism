@model AgroClassLib.FarmOwner.ServiceManagement


<style>

    .error-border {
        border: 2px solid red !important;
    }

    .valid-border {
        border: 2px solid green !important;
    }
</style>
<div class="modal-header @(string.IsNullOrEmpty(Model.RoomCode) ? "bg-success text-white" : "bg-primary text-white")">

    <h4 class="modal-title">
        @(string.IsNullOrEmpty(Model.RoomCode) ? "Add Room" : "Edit Room")
    </h4>

    <button type="button" class="btn-close @(string.IsNullOrEmpty(Model.RoomCode) ? "" : "btn-close-white")" data-bs-dismiss="modal"></button>

</div>
<div class="modal-body">

    <form id="roomForm" enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input type="hidden" name="RoomCode" value="@Model.RoomCode" />

        <!-- Room Name -->

        <div class="form-group row mb-3">

            <label class="col-md-3 col-form-label">Room Name</label>

            <div class="col-md-9">
                <input type="text"
                       id="RoomName"
                       name="RoomName"
                       value="@Model.RoomName"
                       class="form-control"
                       placeholder="Enter Room Name" />

                <small class="text-danger error-msg"></small>
                @Html.ValidationMessageFor(m => m.RoomName, "", new { @class = "text-danger" })
            </div>

        </div>


        <!-- Room Type -->

        <div class="form-group row mb-3">

            <label class="col-md-3 col-form-label">Room Type</label>

            <div class="col-md-9">
                @Html.DropDownListFor(
   m => m.RoomTypeCode,
   ViewBag.RoomTypeList as SelectList,
   "-Select Type-",
   new { @class = "form-control", id = "RoomTypeCode" })

                <small class="text-danger error-msg"></small>

                @Html.ValidationMessageFor(m => m.RoomTypeCode, "", new { @class = "text-danger" })

            </div>

        </div>


        <!-- Capacity -->

        <div class="form-group row mb-3">

            <label class="col-md-3 col-form-label">Guests</label>

            <div class="col-md-9">
                <input type="number"
                       id="Capacity"
                       name="Capacity"
                       value="@Model.Capacity"
                       class="form-control"
                       placeholder="Enter Capacity" />
                <small class="text-danger error-msg"></small>
            </div>

        </div>


        <!-- Price -->

        <div class="form-group row mb-3">

            <label class="col-md-3 col-form-label">Price</label>

            <div class="col-md-9">
                <input type="number"
                       id="Price"
                       name="PricePerNight"
                       value="@Model.PricePerNight"
                       class="form-control" />
                <small class="text-danger error-msg"></small>
            </div>

        </div>


        <!-- Image Upload -->

        <div class="form-group row mb-3">

            <label class="col-md-3 col-form-label">Upload Image</label>

            <div class="col-md-9">

                <input type="file"
                       name="ImageUpload"
                       class="form-control" />

                <input type="hidden"
                       name="ImageFile"
                       value="@Model.ImageFile" />

                @if (!string.IsNullOrEmpty(Model.ImageFile))
                {
                    <div class="mt-2">

                        <label class="fw-bold">Current Image</label>
                        <br />

                        <img src="@Url.Content("~/Content/img/" + Model.ImageFile)"
                             width="150"
                             class="img-thumbnail" />
                    </div>
                }

            </div>

        </div>


        <div class="form-group row mb-3">

            <div class="col-md-9 offset-md-3">

                <button type="button"
                        class="btn btn-outline-primary btn-rounded"
                        onclick="saveRoomGS()">
                    <i class="fa fa-check"></i>
                    @(string.IsNullOrEmpty(Model.RoomCode) ? "Save" : "Update")
                </button>

                <button type="button"
                        class="btn btn-outline-danger btn-rounded"
                        data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cancel
                </button>

            </div>

        </div>

    </form>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function saveRoomGS() {

        if (!validateForm()) {
            return;
        }

        var formData = new FormData($('#roomForm')[0]);

        $.ajax({

            url: '/FarmOwner/SaveRoomGS',

            type: 'POST',

            data: formData,

            processData: false,

            contentType: false,

            success: function (res) {

                if (res.success) {

                    Swal.fire({

                        icon: 'success',

                        title: 'Success',

                        text: 'Room Updated Successfully'

                    }).then(() => {

                        location.reload();

                    });

                }
                else {

                    Swal.fire({

                        icon: 'error',

                        title: 'Error',

                        text: res.message

                    });

                }

            },

            error: function () {

                Swal.fire({

                    icon: 'error',

                    title: 'Server Error'

                });

            }

        });

    }

    function validateField(input, message) {

        var element = $(input);
        var value = element.val();

        if (value == undefined || value == null) {
            value = "";
        } else {
            value = value.toString().trim();
        }

        var error = element.next(".error-msg");

        if (value == "") {

            element.removeClass("valid-border").addClass("error-border");
            error.text(message);
            return false;

        } else {

            element.removeClass("error-border").addClass("valid-border");
            error.text("");
            return true;

        }
    }

    function validateForm() {

        var r1 = validateField("#RoomName", "Room Name Required");
        var r2 = validateField("#RoomTypeCode", "Room Type Required");
        var r3 = validateField("#Capacity", "Guests Required");
        var r4 = validateField("#Price", "Price Required");

        return r1 && r2 && r3 && r4;

    }

</script>