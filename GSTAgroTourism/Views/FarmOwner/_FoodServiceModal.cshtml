@model AgroClassLib.FarmOwner.ServiceManagement

@using (Html.BeginForm("SaveorEditFood", "FarmOwner",
        FormMethod.Post,
        new { enctype = "multipart/form-data", id = "foodForm" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.FoodServiceCode)
    @Html.HiddenFor(m => m.ImageFile)

    <div class="container-fluid ">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Meal Type -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">Meal Type</label>
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.MealTypeCode,
                ViewBag.MealTypeList as SelectList,
                "-Select Meal Type-",
                new { @class = "form-control" })
            </div>
        </div>

        <!-- Food Style -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">Food Style</label>
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.FoodStyleCode,
                ViewBag.FoodTypeList as SelectList,
                "-Select Food Style-",
                new { @class = "form-control" })
            </div>
        </div>

        <!-- Farmhouse -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">Farmhouse</label>
            <div class="col-md-9">
                @Html.DropDownListFor(m => m.FarmhouseCode,
     ViewBag.FarmList as SelectList,
     "-Select Farm-",
     new { @class = "form-control" })
            </div>
        </div>

        <!-- Start Time -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">Start Time</label>
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.StartTime,
                new { @class = "form-control", type = "time" })
            </div>
        </div>

        <!-- End Time -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">End Time</label>
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.EndTime,
                new { @class = "form-control", type = "time" })
            </div>
        </div>

        <!-- Image Upload -->
        <div class="form-group row mb-3">
            <label class="col-md-3 col-form-label">Upload Image</label>
            <div class="col-md-9">

                <input type="file" name="ImageUpload" class="form-control" />

                @if (!string.IsNullOrEmpty(Model?.ImageFile))
                {
                    <div class="mt-2">
                        <img src="@Url.Content(Model.ImageFile)"
                             width="120"
                             height="120"
                             class="img-thumbnail" />
                    </div>
                }

            </div>
        </div>

        <!-- Buttons -->
        <div class="form-group row mb-3">
            <div class="col-md-9 offset-md-3">
                <button type="submit" class="btn btn-outline-primary btn-rounded">
                    @(string.IsNullOrEmpty(Model?.FoodServiceCode) ? "Save" : "Update")
                    <i class="fa fa-pencil"></i>
                </button>
                <button type="button" class="btn btn-outline-danger btn-rounded">
                    <i class="fa fa-times"></i> Cancel
                </button>

            </div>
        </div>

    </div>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    $(document).on("submit", "#foodForm", function (e) {

        e.preventDefault();

        var form = $(this);
        var formData = new FormData(this);

        $.ajax({

            url: form.attr("action"),
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,

            success: function (result) {

                if (result.success) {

                    $("#editModal").modal("hide");

                    Swal.fire({
                        icon: "success",
                        title: "Success!",
                        text: "Record Saved Successfully"
                    }).then(function () {
                        location.reload();
                    });

                } else {

                    Swal.fire("Error", result.message, "error");

                }

            }

        });

    });


</script>
