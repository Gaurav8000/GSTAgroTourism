@model IEnumerable<AgroClassLib.FarmOwner.ServiceManagement>

@{
    ViewBag.Title = "Stay Services (Rooms)";
    Layout = "~/Views/Shared/FarmOwner.cshtml";
}

<style>
    /* ===== DataTable UI Styling ===== */

    #dataTable {
        border-radius: 10px;
        overflow: hidden;
    }

        #dataTable thead th {
            background: linear-gradient(90deg,#1f3b63,#2f5d9a);
            color: white;
            font-size: 15px;
            text-align: center;
        }

        #dataTable tbody tr:hover {
            background: #f4f7fb;
            transition: 0.2s;
        }

        #dataTable tbody td {
            font-size: 14px;
            padding: 10px !important;
        }

    /* Table Borders */
    .dataTable th,
    .dataTable td {
        border: 1px solid #ddd !important;
        text-align: center;
        vertical-align: middle;
    }

    /* Buttons styling */
    .dt-button {
        background: #1f3b63 !important;
        color: white !important;
        border: none !important;
        border-radius: 4px !important;
        padding: 8px 15px !important;
        margin-right: 5px !important;
        font-size: 14px !important;
    }

        .dt-button:hover {
            background: #0f2f57 !important;
        }

    /* Search & dropdown */
    .dataTables_wrapper .dataTables_filter input,
    .dataTables_wrapper .dataTables_length select {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px 10px;
    }

    tr.group {
        background: #e9f1ff;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<div id="customToastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
<!-- FILTER SECTION -->
<div class="card mb-3">
    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label>Search</label>
                <input type="text" id="tableSearch" class="form-control" placeholder="Search...">
            </div>

            <div class="col-md-3">
                <label>Room Type</label>

                @Html.DropDownList(
      "RoomTypeCode",
      ViewBag.RoomTypeList as SelectList,
      "All",
      new { @class = "form-select", id = "roomTypeFilter" }
  )

            </div>
            <div class="col-md-3">
                <label>FarmHouse Name</label>
                @Html.DropDownList(
"RoomTypeCode",
ViewBag.FarmList as SelectList,
"All",
new { @class = "form-select", id = "FarmhouseFilter" }
)
            </div>

            <div class="col-md-3">
                <label>&nbsp;</label>
                <button id="refreshBtn" class="btn btn-outline-primary w-100">
                    <i class="fa fa-rotate-right"></i> Reset
                </button>
            </div>

        </div>
    </div>
</div>
<!-- TABS -->
<ul class="nav nav-tabs justify-content-center">

    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Room" ? "active" : "")"
           href="@Url.Action("ShowRoomTableGS","FarmOwner")">
            Rooms
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Food" ? "active" : "")"
           href="@Url.Action("ShowFoodServicesMealsTableGS","FarmOwner")">
            Food Services
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "Activity" ? "active" : "")"
           href="@Url.Action("ShowActivityTable","FarmOwner")">
            Activities
        </a>
    </li>

</ul>

<!-- Export Buttons -->
<div>
    <button id="excelBtn" class="btn btn-outline-success btn-rounded">
        <i class="fa fa-file-excel"></i>
    </button>

    <button id="pdfBtn" class="btn btn-outline-danger btn-rounded">
        <i class="fa fa-file-pdf"></i>
    </button>

    <button id="printBtn" class="btn btn-outline-primary btn-rounded">
        <i class="fa fa-print"></i>
    </button>
</div>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between mb-3">
        <h3>Stay Services (Rooms)</h3>

        <button class="btn btn-success" onclick="openRoomModal()" style="display:none;">
            <i class="fa fa-plus"></i> Add Room
        </button>
    </div>
    <!-- FILTER SECTION -->
    <!-- TABLE -->
    <table id="dataTable" class="table table-bordered table-hover text-center align-middle">

        <thead>

            <tr>
                <th class="text-center" style="width:0px">
                    <input type="checkbox" id="selectAll" />
                </th>

                <th>Sr.No</th>
                <th>Room Name</th>
                <th>Room Type</th>
                <th>Guests</th>
                <th>Farmhouse Name</th>
                <th>Price</th>
                <th>Action</th>
            </tr>

        </thead>

        <tbody>

            @{
                int sr = 1;
            }

            @foreach (var item in Model)
            {

                <tr>
                    <td>
                        <input type="checkbox" class="rowCheckbox" />
                    </td>

                    <td>@sr</td>

                    <td>@item.RoomName</td>

                    <td>@item.RoomType</td>

                    <td>@item.Capacity</td>

                    <td>@item.FarmhouseName</td>

                    <td>₹ @item.PricePerNight</td>

                    <td>

                        <button type="button" class="btn btn-outline-warning btn-rounded" onclick="openRoomView('@item.RoomCode')">
                            <i class="fa fa-eye"></i> View
                        </button>


                        <button type="button" class="btn btn-outline-primary btn-rounded" onclick="openRoomModal('@item.RoomCode')">
                            <i class="fa fa-pencil"></i> Edit
                        </button>

                    </td>

                </tr>

                sr++;

            }

        </tbody>

    </table>

</div>


<!-- ROOM ADD / EDIT MODAL -->

<div class="modal fade" id="roomModal">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">



            <div class="modal-body" id="roomModalBody"></div>

        </div>

    </div>

</div>


<!-- ROOM VIEW MODAL -->

<div class="modal fade" id="roomViewModal">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div id="roomViewBody"></div>

        </div>

    </div>

</div>


@section Scripts{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        var table;
        var exportSrNo = 0;
        $(document).ready(function () {

            table = $('#dataTable').DataTable({
                responsive: true,
                pageLength: 25,
                dom: 'lfrtip',
                ordering: false,
                buttons: [

                    // ===== EXCEL =====
                    {
                        extend: 'excelHtml5',
                        className: 'buttons-excel',

                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6],

                            rows: function (idx, data, node) {
                                return $(node).find('.rowCheckbox').prop('checked');
                            },

                            format: {
                                body: function (data, row, column, node) {

                                    if (column === 0) {
                                        exportSrNo++;
                                        return exportSrNo;
                                    }

                                    return $('<div>').html(data).text();
                                }
                            }
                        },

                        action: function (e, dt, button, config) {

                            var selected = $('.rowCheckbox:checked').length;

                            if (selected === 0) {
                                showToast("Please select at least one row!", "info");
                                return;
                            }

                            exportSrNo = 0;

                            $.fn.dataTable.ext.buttons.excelHtml5.action
                                .call(this, e, dt, button, config);

                            setTimeout(function () {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Excel Generated!',
                                    text: 'Your Excel file has been downloaded successfully.',
                                    confirmButtonColor: '#1f3b63'
                                });
                            }, 800);
                        },

                        customize: function (xlsx) {

                            if (!xlsx || !xlsx.xl) return;

                            var sheet = xlsx.xl.worksheets['sheet1.xml'];

                            var now = new Date();
                            var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                            $('sheetData', sheet).prepend(
                                '<row r="1">' +
                                '<c t="inlineStr" r="G1"><is><t>Generated on: ' + dateTime + '</t></is></c>' +
                                '</row>'
                            );
                        }
                    },

                    // ===== PDF =====
                    {
                        extend: 'pdfHtml5',
                        className: 'buttons-pdf',

                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6],

                            rows: function (idx, data, node) {
                                return $(node).find('.rowCheckbox').prop('checked');
                            },

                            format: {
                                body: function (data, row, column, node) {

                                    if (column === 0) {
                                        exportSrNo++;
                                        return exportSrNo;
                                    }

                                    return $('<div>').html(data).text();
                                }
                            },

                            // 🔥 FIXED PDF DATE (IMPORTANT)
                            customize: function (doc) {

                                var now = new Date();
                                var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                                // ✅ TOP SPACE FIX (VERY IMPORTANT)
                                doc.pageMargins = [20, 70, 20, 30];

                                // ✅ ADD TITLE (fix alignment issue)
                                doc.content.splice(0, 0, {
                                    text: "Stay Services (Rooms)",
                                    alignment: "center",
                                    fontSize: 14,
                                    bold: true,
                                    margin: [0, 0, 0, 10]
                                });

                                // ✅ HEADER (DATE)
                                doc.header = function () {
                                    return {
                                        margin: [20, 20, 20, 0],
                                        columns: [
                                            { text: '' },
                                            {
                                                text: "Generated on: " + dateTime,
                                                alignment: 'right',
                                                fontSize: 10,
                                                bold: true
                                            }
                                        ]
                                    };
                                };

                                // ✅ SAFE TABLE WIDTH FIX
                                if (doc.content[1] && doc.content[1].table) {
                                    var colCount = doc.content[1].table.body[0].length;
                                    doc.content[1].table.widths = Array(colCount).fill('*');
                                }
                            }
                        },

                        action: function (e, dt, button, config) {

                            var selected = $('.rowCheckbox:checked').length;

                            if (selected === 0) {
                                showToast("Please select at least one row!", "info");
                                return;
                            }

                            exportSrNo = 0;

                            $.fn.dataTable.ext.buttons.pdfHtml5.action
                                .call(this, e, dt, button, config);

                            setTimeout(function () {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'PDF Generated!',
                                    text: 'Your PDF file has been downloaded successfully.',
                                    confirmButtonColor: '#1f3b63'
                                });
                            }, 800);
                        }
                    },

                    // ===== PRINT =====
                    {
                        extend: 'print',
                        className: 'buttons-print',

                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6],

                            rows: function (idx, data, node) {
                                return $(node).find('.rowCheckbox').prop('checked');
                            },

                            format: {
                                body: function (data, row, column, node) {

                                    if (column === 0) {
                                        exportSrNo++;
                                        return exportSrNo;
                                    }

                                    return $('<div>').html(data).text();
                                }
                            }
                        },

                        action: function (e, dt, button, config) {

                            var selected = $('.rowCheckbox:checked').length;

                            if (selected === 0) {
                                showToast("Please select at least one row!", "info");
                                return;
                            }

                            exportSrNo = 0;

                            $.fn.dataTable.ext.buttons.print.action
                                .call(this, e, dt, button, config);
                        },

                        customize: function (win) {

                            var now = new Date();
                            var dateTime = now.toLocaleDateString() + " " + now.toLocaleTimeString();

                            $(win.document.body).prepend(
                                '<div style="text-align:right; font-size:12px; margin-bottom:10px;">' +
                                'Generated on: ' + dateTime +
                                '</div>'
                            );
                        }
                    }

                ],
                columnDefs: [
                    { visible: false, targets: 5 }
                ],

                order: [[5, 'asc']],

                drawCallback: function (settings) {

                    var api = this.api();
                    var rows = api.rows({ page: 'current' }).nodes();
                    var last = null;

                    api.column(5, { page: 'current' }).data().each(function (group, i) {

                        if (last !== group) {

                            $(rows).eq(i).before(
                                '<tr class="group"><td colspan="8">▶ ' + group + '</td></tr>'
                            );

                            last = group;
                        }

                    });

                }

            });
            table.on('draw.dt', function () {

                var PageInfo = table.page.info();

                table.column(1, { page: 'current' }).nodes().each(function (cell, i) {

                    cell.innerHTML = PageInfo.start + i + 1;

                });

            });

            /* SEARCH FILTER */
            $('#tableSearch').keyup(function () {

                table.search($(this).val()).draw();

            });

            /* ROOM TYPE FILTER */
            $('#roomTypeFilter').change(function () {

                var selected = $(this).find("option:selected").text();

                if (selected === "All") {
                    table.column(3).search('').draw();
                }
                else {
                    table.column(3).search('^' + selected + '$', true, false).draw();
                }

            });

            /* FARMHOUSE FILTER */
            $('#FarmhouseFilter').change(function () {

                var selected = $(this).find("option:selected").text();

                if (selected === "All") {
                    table.column(5).search('').draw();
                }
                else {
                    table.column(5).search('^' + selected + '$', true, false).draw();
                }

            });

            /* RESET FILTER */
            $('#refreshBtn').click(function () {

                // Reset search & dropdown
                $('#tableSearch').val('');
                $('#roomTypeFilter').val('');
                $('#FarmhouseFilter').val('');

                // Reset DataTable filters
                table.search('').columns().search('').draw();

                // Uncheck all row checkboxes
                $('.rowCheckbox').prop('checked', false);

                // Uncheck select all checkbox
                $('#selectAll').prop('checked', false);

            });


            /* EXPORT BUTTONS */

            $('#excelBtn').click(function () {

                table.button('.buttons-excel').trigger();

            });

            $('#pdfBtn').click(function () {

                table.button('.buttons-pdf').trigger();

            });

            $('#printBtn').click(function () {

                table.button('.buttons-print').trigger();

            });


            /* SELECT ALL */

            $('#selectAll').click(function () {

                $('.rowCheckbox').prop('checked', this.checked);

            });


            $(document).on("change", ".rowCheckbox", function () {

                let total = $(".rowCheckbox").length;
                let checked = $(".rowCheckbox:checked").length;

                $("#selectAll").prop("checked", total === checked);

            });

        });


        /* MODAL OPEN */

        function openRoomModal(id = "") {

            $.get("/FarmOwner/RoomModalGS", { id: id }, function (data) {

                $("#roomModalBody").html(data);

                var modal = new bootstrap.Modal(document.getElementById('roomModal'));
                modal.show();

            });

        }


        function openRoomView(id) {

            $.get("/FarmOwner/RoomModalViewGS", { id: id }, function (data) {

                $("#roomViewBody").html(data);

                var modal = new bootstrap.Modal(document.getElementById('roomViewModal'));
                modal.show();

            });

        }
        $('#dataTable tbody').on('click', 'tr.group', function () {

            var rows = $(this).nextUntil('.group');

            if (rows.is(':visible')) {
                rows.hide();
            } else {
                rows.show();
            }

            table.draw(false);   // 🔥 pagination adjust hoil

        });
        function showToast(message, type = "info") {

            let icon = "fa-circle-info";
            let bgColor = "#17a2b8"; // info

            if (type === "success") {
                icon = "fa-circle-check";
                bgColor = "#28a745";
            }
            else if (type === "error") {
                icon = "fa-circle-xmark";
                bgColor = "#dc3545";
            }
            else if (type === "warning") {
                icon = "fa-triangle-exclamation";
                bgColor = "#ffc107";
            }

            let toast = `
            <div class="toast-msg" style="
                min-width:250px;
                margin-bottom:10px;
                padding:12px 15px;
                background:${bgColor};
                color:white;
                border-radius:6px;
                box-shadow:0 2px 8px rgba(0,0,0,0.2);
                display:flex;
                align-items:center;
                gap:10px;
            ">
                <i class="fa ${icon}"></i>
                <span>${message}</span>
            </div>
        `;

            let $toast = $(toast).appendTo('#customToastContainer');

            setTimeout(function () {
                $toast.fadeOut(500, function () {
                    $(this).remove();
                });
            }, 3000);
        }
    </script>


}