@model AgroClassLib.FarmOwner.ServiceManagement

@using (Html.BeginForm("SaveRoom", "FarmOwner",
        FormMethod.Post,
        new { enctype = "multipart/form-data", id = "roomForm" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.RoomCode)
    @Html.HiddenFor(m => m.ImageFile)

    <div class="container-fluid">

        <h4>
            @(string.IsNullOrEmpty(Model?.RoomCode)
            ? "Add Room"
            : "Edit Room")
        </h4>

        <hr />

        <!-- Room Name -->
        <div class="form-group">
            <label>Room Name</label>
            @Html.TextBoxFor(m => m.RoomName,
            new { @class = "form-control" })
        </div>

        <!-- Room Type -->
        <div class="form-group">
            <label>Room Type</label>

            @Html.DropDownListFor(m => m.RoomTypeCode,
            ViewBag.RoomTypeList as SelectList,
            "-Select Room Type-",
            new { @class = "form-control" })

        </div>

        <!-- Guests -->
        <div class="form-group">
            <label>Number Of Guests</label>

            @Html.TextBoxFor(m => m.Capacity,
            new { @class = "form-control", type = "number" })

        </div>

        <!-- Price -->
        <div class="form-group">
            <label>Price Per Night</label>

            @Html.TextBoxFor(m => m.Price,
            new { @class = "form-control" })

        </div>

        <!-- Image Upload -->
        <div class="form-group">

            <label>Upload Image</label>

            <input type="file" name="ImageUpload" class="form-control" />

            @if (!string.IsNullOrEmpty(Model?.ImageFile))
            {
                <div class="mt-2">
<img src="@Url.Content("~/Content/img/" + Model.ImageFile)"
     width="120"
     class="img-thumbnail" />
                </div>
            }

        </div>

        <!-- Buttons -->
        <div class="form-group">

            <button type="submit" class="btn btn-success">
                @(string.IsNullOrEmpty(Model?.RoomCode)
                ? "Save"
                : "Update")
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    data-dismiss="modal">
                Cancel
            </button>

        </div>

    </div>
}
